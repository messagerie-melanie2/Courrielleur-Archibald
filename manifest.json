{
  "manifest_version": 3,
  "name": "Archibald",
  "version": "1.0",
  "description": "Extension d'archivage de boîtes.",
  "browser_specific_settings": {
    "gecko": {
      "id": "archibald@developpement-durable.fr"
    }
  },
  "experiment_apis": {
    "archibaldApi": {
      "schema": "./api/archibaldApi/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["archibaldApi"]],
        "script": "./api/archibaldApi/implementation.js"
      }
    }
  },
  "action": {
    "default_title": "Archibald",
    "default_icon": {
      "32": "skin/images/archibald_logo_32_light.png"
    }
  },
  "options_ui": {
    "page": "content/archibald.html",
    "open_in_tab": true,
    "browser_style": true
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "tabs",
    "notifications",
    "storage",
    "menus",
    "compose",
    "accountsRead",
    "messagesRead",
    "messagesMove"
  ],
  "icons": {
    "32": "skin/images/archibald_logo_32.png"
  },
  "web_accessible_resources": [
  {
    "resources": [
      "content/archibald.html",
      "content/archibaldHelpers.js",
      "content/default/preferences/default_pref.json"
    ],
    "matches": ["<all_urls>"]
  }
]
}
