{
  "manifest_version": 2,
  "name": "Archibald",
  "version": "1.0",
  "description": "Extension d'archivage de boîtes.",
  "applications": {
    "gecko": {
      "id": "archibald@developpement-durable.fr",
      "strict_min_version": "102.0"
    }
  },
  "experiment_apis": {
    "domapi": {
      "schema": "./api/domapi/schema.json",
      "parent" : {
          "scopes": ["addon_parent"],
          "paths": [["domapi"]],
          "script": "./api/domapi/implementation.js"
      }
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Archibald",
    "default_icon": {
      "18": "skin/images/archibald_logo_18_light.png",
      "32": "skin/images/archibald_logo_32_light.png"
    }
  },
  "permissions": [
    "tabs",
    "notifications",
    "storage",
    "menus",
    "compose",
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "downloads"
  ],
  "icons": {
    "32": "skin/images/archibald_logo_32.png"
  },
  "web_accessible_resources": [
    "content/archibald.html",
    "content/archibaldHelpers.js",
    "content/default/preferences/default_pref.json"
  ]
}
