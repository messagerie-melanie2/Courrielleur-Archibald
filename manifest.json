{
  "manifest_version": 3,
  "name": "Archibald",
  "version": "1.0",
  "description": "Extension d'archivage de boîtes.",
  "applications": {
	  "gecko": {
		"id": "my-extension@example.com"
	  }
	},
  "experiment_apis": {
    "fileIO": {
      "schema": "./api/fileIO/schema.json",
      "parent": {
        "paths": [["fileIO"]],
        "scopes": ["addon_parent"],
        "script": "./api/fileIO/implementation.js"
      }
    }
  },
  "action": {
    "default_title": "Archibald",
    "default_popup": "content/archibald.html"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "permissions": [
    "tabs",
    "notifications",
    "storage",
    "menus",
    "compose",
    "accountsRead",
    "messagesRead",
    "messagesMove"
  ],
  "icons": {
    "32": "skin/images/archibald_logo_32.png"
  },
  "web_accessible_resources": [
  {
    "resources": [
      "content/archibald.html",
      "content/archibaldHelpers.js",
      "content/default/preferences/default_pref.json"
    ],
    "matches": ["<all_urls>"]
  }
]
}
