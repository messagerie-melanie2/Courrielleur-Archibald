[
  {
    "namespace": "archibaldApi",
    "functions": [
      {
        "name": "createArchiveLocalFolder",
        "type": "function",
        "description": "Write new local folder",
        "parameters": [
          { "name": "accountId", "type": "string" },
          { "name": "name", "type": "string" },
          { "name": "parent", "type": "string" }
        ],
        "async": true,
        "returns": { "type": "any" }
      },
      {
        "name": "init",
        "type": "function",
        "parameters": [],
        "async": false
      },
      {
        "name": "showFilePicker",
        "type": "function",
        "description": "Show a native file or folder picker and return the selected path(s).",
        "parameters": [
          {
            "name": "options",
            "type": "object",
            "optional": true,
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["open", "openMultiple", "save", "openFolder"],
                "optional": true
              },
              "title": { "type": "string", "optional": true },
              "startDir": { "type": "string", "optional": true },
              "filters": {
                "type": "array",
                "optional": true,
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "extensions": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        ],
        "async": true,
        "returns": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      {
        "name": "createCustomLocalFolder",
        "type": "function",
        "description": "Create (or ensure) a custom local folder account for the given account at the specified path. Returns the created account key (e.g. 'account7').",
        "parameters": [
          { "name": "accountId", "type": "string" },
          { "name": "path", "type": "string" }
        ],
        "async": true,
        "returns": { "type": "any" }
      },
      {
        "name": "removeCustomLocalFolder",
        "type": "function",
        "description": "Remove a previously created custom local folder account. Optionally deletes its on-disk data.",
        "parameters": [
          {
            "name": "accountKey",
            "type": "string",
            "description": "The account key of the custom local account to remove (e.g. 'account7')."
          }
        ],
        "async": true,
        "returns": { "type": "any" }
      }
    ],
    "events": [
      {
        "name": "onArchive",
        "type": "function",
        "description": "Fired when Thunderbird core sends an archive notification.",
        "parameters": [
          { "name": "data", "type": "any" }
        ]
      }
    ]
  }
]
